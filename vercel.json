{
  "rewrites": [
    {
      "source": "/blog/edit-with-vlada-ai",
      "destination": "https://vladasana-edit-guides.vercel.app/blog/edit-with-vlada-ai"
    },
    {
      "source": "/blog/edit-with-vlada-ai/:path*",
      "destination": "https://vladasana-edit-guides.vercel.app/blog/edit-with-vlada-ai/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(shared|media|fonts|vendor)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
