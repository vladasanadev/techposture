# Keep production closed until real checkout-to-inbox acceptance passes.
COMMERCE_MODE=preview
COMMERCE_LAUNCH_APPROVED=false
BUNDLE_FINAL_APPROVED=true
SITE_URL=https://vladasana-job-bundle.vercel.app
SELLER_COUNTRY=UA
SELLER_LEGAL_NAME=Vladyslava Kandyba
SUPPORT_EMAIL=support@vladasana.com
DATABASE_URL=

# Files are uploaded in the ORIGINAL Vercel project's private Blob store.
# A NEW Vercel project needs its own storage connection/token and both URLs.
# See docs/VERCEL_SETUP.md. Never put paid files in public/ or Git.
# The loader uses BLOB_READ_WRITE_TOKEN unless BUNDLE_PDF_BEARER_TOKEN is explicitly supplied.
BLOB_READ_WRITE_TOKEN=
BUNDLE_PDF_BEARER_TOKEN=
BUNDLE_PDF_URL=
BUNDLE_PDF_SHA256=d4638217bac98ebd075f0c8514ebb531a966a9e9a14951d370155476764b0328
BUNDLE_ARCHIVE_URL=
BUNDLE_ARCHIVE_SHA256=b2eb9e732fb8c19801f849ea780c744e15496560773fcc1fed7cfd7584225f46
BUNDLE_VERSION=developer-playbook-2026-09-08
BUNDLE_FILENAME=developer-job-search-playbook.pdf
BUNDLE_ARCHIVE_FILENAME=developer-job-search-playbook.zip
DOWNLOAD_SIGNING_SECRET=

# Paddle Billing (NOT Paddle Classic). Separate sandbox/live accounts and values.
# Only the client token is passed to the payment-page browser. Never expose the API or webhook keys.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRODUCT_ID=
PADDLE_PRICE_ID=
PADDLE_DOMAIN_APPROVED=false

# Resend: verified sender domain, working reply mailbox and signing secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Vlada <delivery@vladasana.com>

# NOWPayments live invoices. Each token includes its exact network.
# Enable the selected networks and payout wallets in NOWPayments first.
# These nine selected networks passed the merchant API check on September 9.
# USDC/Polygon (usdcmatic) was not enabled for this key and is excluded.
# Run npm run commerce:check-crypto after entering your key and selected codes.
# The server supplies SITE_URL + /api/webhooks/crypto on each unique invoice.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_TOKENS=usdtbsc,usdcbsc,usdtmatic,usdcarb,usdtarb,usdcsol,usdterc20,usdc,usdttrc20
# Keep this false for a new merchant or payout configuration until rechecked.
NOWPAYMENTS_NETWORKS_APPROVED=false

# Independent random secrets; the production download secret is already generated.
CRON_SECRET=
# The shipped five-minute Vercel cron requires Pro or Enterprise.
DELIVERY_RETRY_MODE=cron
# Optional alternative: qstash, with all four values below.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
QSTASH_URL=https://qstash.upstash.io
# Approve cron only after a real five-minute schedule and authenticated run are verified.
COMMERCE_RETRY_SCHEDULE_APPROVED=false

# Historical Stripe/PayPal orders ONLY. New checkout rejects these provider IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=
